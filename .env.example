# Optional: point the frontend to a remote backend API.
# Leave empty in local dev so Vite proxy forwards /api to the local Node server.
VITE_API_BASE_URL=

# Required to enable admin login endpoints.
# Use ADMIN_PASSWORD_HASH (bcrypt) for production.
# ADMIN_PASSWORD is supported for local/dev fallback only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Optional admin session lifetime in milliseconds (default 8 hours).
ADMIN_SESSION_TTL_MS=28800000

# Optional JWT claim hardening values.
ADMIN_JWT_ISSUER=plant-dashboard
ADMIN_JWT_AUDIENCE=plant-dashboard-admin
